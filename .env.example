# Copy to .env and fill in. .env is gitignored; never commit keys.

# Which provider the agent uses: local, anthropic or openai (ADR 0005)
LLM_PROVIDER=

# Local model via Ollama (ADR 0014)
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Paid providers; set spend limits in both consoles first (ADR 0012)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
