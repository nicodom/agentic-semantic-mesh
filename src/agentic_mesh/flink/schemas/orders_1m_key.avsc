  "type": "record",
  "name": "OrdersPerMinuteKey",
  "namespace": "agentic_mesh.metrics",
  "doc": "Kafka record key of metrics.orders_1m: the window. The identity of a row; a repeated window (possible after a crash, ADR 0023) carries the same counts.",
